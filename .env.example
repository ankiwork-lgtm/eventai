# Server-only (never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Optional: override the default api.anthropic.com endpoint (e.g. an LLM gateway).
# Read by @ai-sdk/anthropic as ANTHROPIC_BASE_URL. Must include the /v1 suffix
# (the SDK appends /messages directly), e.g. https://gateway.example.com/v1
# ANTHROPIC_BASE_URL=

LLM_MODEL=claude-sonnet-4-5

# Public: when "true", the dashboard skips the LLM and replays the cached fixture
# (lib/fixtures) for the three demo scenarios, no API call. Also enabled per-visit
# with ?demo=1. Non-demo inputs still call the API. On failure the dashboard always
# offers "Use sample plan" for demo-scenario inputs, regardless of this flag.
NEXT_PUBLIC_DEMO_FALLBACK=false

# Optional
# UNSPLASH_ACCESS_KEY=
# DATABASE_URL=
